{
  "name": "AI Operations Autopilot - Business Operations (Invoice & Refund Dispute)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "business-dispute" },
      "id": "biz-webhook",
      "name": "Dispute Ingest Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 300]
    },
    {
      "parameters": { "prompt": "Check if refund amount exceeds ₹10,000 threshold. If yes, generate human approval payload." },
      "id": "biz-ai-gate",
      "name": "Financial Risk Gate AI",
      "type": "n8n-nodes-base.openAi",
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{$json.amount}}", "operation": "larger", "value2": 10000 }]
        }
      },
      "id": "biz-amount-router",
      "name": "High Value Router",
      "type": "n8n-nodes-base.if",
      "position": [680, 300]
    },
    {
      "parameters": { "channel": "#ops-approvals", "text": "⚠️ HUMAN APPROVAL REQUIRED: Refund ₹{{$json.amount}} for {{$json.client}} requires supervisor sign-off." },
      "id": "biz-approval-alert",
      "name": "Send Supervisor Approval Card",
      "type": "n8n-nodes-base.slack",
      "position": [920, 200]
    }
  ]
}
